# Copy to .env and adjust. .env is gitignored; never commit real credentials.

# --- Trading gateway ---------------------------------------------------------
TRADING_GATEWAY_PORT=8080
TRADING_UI_PORT=8081
# Host-side port for Stage 10's persistent TCP order-entry protocol (docker-compose only; the
# in-container port is always 9090). Not 9090 on the host - Prometheus already claims that port
# below. See docs/tcp-protocol.md.
TRADING_GATEWAY_TCP_PORT=9091

# apiKey:accountId pairs, comma separated. Required: the gateway refuses to start without it.
# These are local development placeholders, not credentials.
GATEWAY_API_KEYS=local-dev-key:ACC-DEV,local-dev-key-2:ACC-DEV-2

# SYMBOL:referencePriceTicks pairs. A reference price of 0 means the instrument cannot accept
# market orders until it has traded once.
GATEWAY_INSTRUMENTS=AAPL:19000,MSFT:42000,NVDA:12000,TSLA:24000

# --- Matching ----------------------------------------------------------------
MATCHING_WORKERS=4
MATCHING_QUEUE_CAPACITY=8192
MATCHING_COMMAND_TIMEOUT=2s

# Durable recovery of matching-engine state across a restart. See docs/architecture-decisions/
# ADR-015-matching-engine-durability.md.
MATCHING_JOURNAL_ENABLED=true
MATCHING_JOURNAL_DIR=./data/matching-journal
MATCHING_JOURNAL_FLUSH_POLICY=EVERY_RECORD

# --- TCP order-entry protocol (Stage 10) --------------------------------------
# See docs/tcp-protocol.md and ADR-016. false runs the gateway with only the REST/Protobuf HTTP
# paths, exactly as it did before Stage 10.
TCP_ENABLED=true
TCP_PORT=9090
TCP_MAX_CONNECTIONS=512
TCP_DISPATCH_POOL_SIZE=8
TCP_DISPATCH_QUEUE_CAPACITY=2048
TCP_OUTBOUND_QUEUE_CAPACITY=256
TCP_MAX_CONSECUTIVE_DROPS=50
TCP_AUTH_TIMEOUT=5s
TCP_IDLE_TIMEOUT=5m
TCP_MAX_FRAME_LENGTH=4096

# --- Pre-trade risk ----------------------------------------------------------
RISK_MAX_ORDER_QUANTITY=10000
RISK_MAX_ORDER_NOTIONAL=100000000
RISK_MAX_OPEN_ORDERS=500
RISK_MAX_POSITION_QUANTITY=100000

# --- Rate limiting -----------------------------------------------------------
RATE_LIMIT_PERMITS_PER_SECOND=200
RATE_LIMIT_BURST=400

# --- Durable portfolio (Postgres) ---------------------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_NAME=trading
DB_USERNAME=trading
DB_PASSWORD=change-me
# Deliberately small: a saturated pool should show up as consumer lag, not as a starved gateway.
DB_POOL_SIZE=10

# --- Kafka event pipeline ----------------------------------------------------
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# false runs the gateway with no broker: it trades normally but publishes nothing.
PIPELINE_ENABLED=true
PIPELINE_PUBLISH_QUEUE_CAPACITY=100000
# Cannot be lowered later, and raising it re-hashes keys to different partitions.
PIPELINE_TOPIC_PARTITIONS=12
PIPELINE_TOPIC_REPLICAS=1
PIPELINE_AUDIT_LOG_MAX_ENTRIES=100000
PIPELINE_CONSUMER_IDLE_INTERVAL=2s
PIPELINE_RETRY_MAX_ATTEMPTS=4
PIPELINE_RETRY_INITIAL_INTERVAL=200ms
PIPELINE_RETRY_MULTIPLIER=2.0
PIPELINE_RETRY_MAX_INTERVAL=5s

# --- Logging -----------------------------------------------------------------
# DEBUG adds a per-command routing trace (worker id, sequence numbers, queue and processing time).
LOG_LEVEL=INFO
