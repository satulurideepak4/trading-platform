<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.tradingplatform</groupId>
        <artifactId>trading-platform</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>benchmark</artifactId>
    <name>Benchmark</name>

    <!-- Depends on matching-engine (Stage 9's own workloads, in-process) and, as of Stage 10, on
         trading-gateway too — the HTTP+JSON/HTTP+Protobuf/TCP+binary comparison targets need the
         real request/response DTOs and generated Protobuf types the gateway actually ships, not
         reinvented parallel copies, or the comparison would not be measuring what the gateway
         really sends over the wire. This is a deliberate extension of the same "real shipped code,
         not reinvented" principle Stage 9 stated for matching-engine, not drift from it. -->
    <dependencies>
        <dependency>
            <groupId>com.tradingplatform</groupId>
            <artifactId>matching-engine</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.tradingplatform</groupId>
            <artifactId>trading-gateway</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!-- Standard JMH+Maven wiring: jmh-generator-annprocess is picked up automatically as an
             annotation processor because it's on the compile classpath, the same way every JMH
             Maven quickstart is set up — no separate annotationProcessorPaths block needed. -->
        <dependency>
            <groupId>org.openjdk.jmh</groupId>
            <artifactId>jmh-core</artifactId>
            <version>${jmh.version}</version>
        </dependency>
        <dependency>
            <groupId>org.openjdk.jmh</groupId>
            <artifactId>jmh-generator-annprocess</artifactId>
            <version>${jmh.version}</version>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- Shades a self-contained benchmarks.jar with JMH's own CLI as the entry point:
                 `java -jar target/benchmarks.jar` lists and runs every @Benchmark method with
                 full control over forks/warmup/measurement from the command line. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.6.0</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <finalName>benchmarks</finalName>
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                            <filters>
                                <filter>
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <exclude>META-INF/MANIFEST.MF</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                            <transformers>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <mainClass>org.openjdk.jmh.Main</mainClass>
                                </transformer>
                            </transformers>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <!-- The load runner and comparison harnesses are plain CLI classes, not JMH benchmarks;
                 run directly with `mvn -pl benchmark exec:java -Dexec.mainClass=...` rather than
                 through the shaded JMH jar, which is specifically JMH's own entry point. -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
