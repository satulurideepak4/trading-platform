{
  "id": null,
  "uid": "trading-overview",
  "title": "Overview",
  "description": "Is the system healthy right now? Request rate, error rate, JVM heap/CPU/threads, GC pause. First dashboard to open, not the deepest one.",
  "tags": ["trading-platform"],
  "editable": true,
  "graphTooltip": 1,
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": {"from": "now-30m", "to": "now"},
  "timezone": "",
  "links": [],
  "annotations": {"list": []},
  "templating": {"list": []},
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Gateway up",
      "gridPos": {"h": 4, "w": 4, "x": 0, "y": 0},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {"expr": "up{job=\"trading-gateway\"}", "legendFormat": "up", "refId": "A"}
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {"type": "value", "options": {"0": {"text": "DOWN", "color": "red"}, "1": {"text": "UP", "color": "green"}}}
          ],
          "thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "green", "value": 1}]}
        },
        "overrides": []
      },
      "options": {"reduceOptions": {"calcs": ["lastNotNull"]}, "textMode": "value", "colorMode": "background"}
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Request rate (req/s)",
      "gridPos": {"h": 4, "w": 4, "x": 4, "y": 0},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {"expr": "sum(rate(http_server_requests_seconds_count{application=\"trading-gateway\"}[1m]))", "legendFormat": "req/s", "refId": "A"}
      ],
      "fieldConfig": {"defaults": {"decimals": 1}, "overrides": []},
      "options": {"reduceOptions": {"calcs": ["lastNotNull"]}, "textMode": "value", "colorMode": "value"}
    },
    {
      "id": 3,
      "type": "stat",
      "title": "5xx error rate (%)",
      "gridPos": {"h": 4, "w": 4, "x": 8, "y": 0},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {
          "expr": "100 * sum(rate(http_server_requests_seconds_count{application=\"trading-gateway\",status=~\"5..\"}[5m])) / clamp_min(sum(rate(http_server_requests_seconds_count{application=\"trading-gateway\"}[5m])), 0.001)",
          "legendFormat": "5xx %",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 2,
          "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "orange", "value": 1}, {"color": "red", "value": 5}]}
        },
        "overrides": []
      },
      "options": {"reduceOptions": {"calcs": ["lastNotNull"]}, "textMode": "value", "colorMode": "value"}
    },
    {
      "id": 4,
      "type": "stat",
      "title": "JVM heap used / max",
      "gridPos": {"h": 4, "w": 4, "x": 12, "y": 0},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {
          "expr": "100 * sum(jvm_memory_used_bytes{area=\"heap\",application=\"trading-gateway\"}) / sum(jvm_memory_max_bytes{area=\"heap\",application=\"trading-gateway\"})",
          "legendFormat": "heap %",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 1,
          "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "orange", "value": 70}, {"color": "red", "value": 85}]}
        },
        "overrides": []
      },
      "options": {"reduceOptions": {"calcs": ["lastNotNull"]}, "textMode": "value", "colorMode": "value"}
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Live threads",
      "gridPos": {"h": 4, "w": 4, "x": 16, "y": 0},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {"expr": "jvm_threads_live_threads{application=\"trading-gateway\"}", "legendFormat": "threads", "refId": "A"}
      ],
      "fieldConfig": {"defaults": {"decimals": 0}, "overrides": []},
      "options": {"reduceOptions": {"calcs": ["lastNotNull"]}, "textMode": "value", "colorMode": "value"}
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Process CPU usage",
      "gridPos": {"h": 4, "w": 4, "x": 20, "y": 0},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {"expr": "process_cpu_usage{application=\"trading-gateway\"} * 100", "legendFormat": "CPU %", "refId": "A"}
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 1,
          "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "orange", "value": 70}, {"color": "red", "value": 90}]}
        },
        "overrides": []
      },
      "options": {"reduceOptions": {"calcs": ["lastNotNull"]}, "textMode": "value", "colorMode": "value"}
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "HTTP requests by status class",
      "description": "Answers whether traffic is growing and whether errors are a meaningful share of it.",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 4},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {
          "expr": "sum(rate(http_server_requests_seconds_count{application=\"trading-gateway\"}[1m])) by (status)",
          "legendFormat": "{{status}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {"defaults": {"unit": "reqps", "custom": {"drawStyle": "line", "fillOpacity": 10, "stacking": {"mode": "normal"}}}, "overrides": []},
      "options": {"legend": {"displayMode": "list", "placement": "bottom"}, "tooltip": {"mode": "multi"}}
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Gateway HTTP latency (p50/p95/p99)",
      "description": "Auto-instrumented by Spring Boot; percentiles enabled via management.metrics.distribution.percentiles-histogram.http.server.requests.",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 4},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {"expr": "http_server_requests_seconds{application=\"trading-gateway\",quantile=\"0.5\"}", "legendFormat": "p50", "refId": "A"},
        {"expr": "http_server_requests_seconds{application=\"trading-gateway\",quantile=\"0.95\"}", "legendFormat": "p95", "refId": "B"},
        {"expr": "http_server_requests_seconds{application=\"trading-gateway\",quantile=\"0.99\"}", "legendFormat": "p99", "refId": "C"}
      ],
      "fieldConfig": {"defaults": {"unit": "s", "custom": {"drawStyle": "line", "fillOpacity": 5}}, "overrides": []},
      "options": {"legend": {"displayMode": "list", "placement": "bottom"}, "tooltip": {"mode": "multi"}}
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "JVM heap used vs. max",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 12},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {"expr": "sum(jvm_memory_used_bytes{area=\"heap\",application=\"trading-gateway\"})", "legendFormat": "used", "refId": "A"},
        {"expr": "sum(jvm_memory_max_bytes{area=\"heap\",application=\"trading-gateway\"})", "legendFormat": "max", "refId": "B"}
      ],
      "fieldConfig": {"defaults": {"unit": "bytes", "custom": {"drawStyle": "line", "fillOpacity": 10}}, "overrides": []},
      "options": {"legend": {"displayMode": "list", "placement": "bottom"}, "tooltip": {"mode": "multi"}}
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "GC pause time",
      "description": "Answers 'is GC affecting latency' directly when read next to the latency panels above — a spike here lining up with a latency spike is the tell.",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 12},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {"expr": "rate(jvm_gc_pause_seconds_sum{application=\"trading-gateway\"}[1m])", "legendFormat": "{{action}} / {{cause}}", "refId": "A"}
      ],
      "fieldConfig": {"defaults": {"unit": "s", "custom": {"drawStyle": "bars", "fillOpacity": 30}}, "overrides": []},
      "options": {"legend": {"displayMode": "list", "placement": "bottom"}, "tooltip": {"mode": "multi"}}
    }
  ]
}
