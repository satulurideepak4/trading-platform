<?xml version="1.0" encoding="UTF-8"?>
<!--
  Key=value output so that logs stay greppable by hand and parseable by a collector without a JSON
  encoder dependency. correlationId and accountId come from the MDC, which is how an order is
  followed from ingress through routing.
-->
<configuration>
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{yyyy-MM-dd'T'HH:mm:ss.SSSXXX} %-5level [%thread] logger=%logger{36} correlationId=%X{correlationId:-none} accountId=%X{accountId:-none} %msg%n</pattern>
        </encoder>
    </appender>

    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
    </root>
</configuration>
